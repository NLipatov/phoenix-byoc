{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phoenix.invalid/contracts/llm-connections/v1/values.schema.json",
  "title": "Phoenix named LLM and generic input authoring v1 (mergeable chart fragment)",
  "type": "object",
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "CONFIG_VERSION": {
          "const": "1"
        },
        "connections": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/llmConnectionsV1_bedrock-anthropic"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_vertex-anthropic"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_vertex-gemini"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_azure-anthropic"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_azure-openai"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_portkey-anthropic"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_portkey-openai"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_portkey-gemini"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_portkey-mixed"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_direct-anthropic"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_direct-openai"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_direct-gemini"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_custom-openai-compatible"
              },
              {
                "$ref": "#/definitions/llmConnectionsV1_custom-anthropic-compatible"
              }
            ]
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/llmConnectionsV1_plainDestination"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "description": "Non-secret connection inputs only; no process environment scanning.",
          "maxProperties": 256
        },
        "secretEnv": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/llmConnectionsV1_secretDestination"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$",
                "not": {
                  "pattern": "[^a-z0-9.-]"
                }
              },
              "key": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[-._a-zA-Z0-9]+$",
                "not": {
                  "anyOf": [
                    {
                      "const": "."
                    },
                    {
                      "pattern": "^\\.\\."
                    },
                    {
                      "pattern": "[^-._a-zA-Z0-9]"
                    }
                  ]
                }
              }
            },
            "required": [
              "name",
              "key"
            ],
            "additionalProperties": false
          },
          "maxProperties": 128
        },
        "platformEnv": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/llmConnectionsV1_plainDestination"
          },
          "description": "Explicit runtime-injected names subject to a trusted platform allowlist; never engine os.Environ().",
          "maxItems": 256
        }
      },
      "required": [
        "CONFIG_VERSION",
        "connections"
      ],
      "additionalProperties": false,
      "minProperties": 2
    },
    "agentInputDelivery": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedEnterpriseIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/llmConnectionsV1_plainDestination"
          },
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 256
        },
        "secretEnv": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/llmConnectionsV1_secretDestination"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$",
                "not": {
                  "pattern": "[^a-z0-9.-]"
                }
              },
              "key": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[-._a-zA-Z0-9]+$",
                "not": {
                  "anyOf": [
                    {
                      "const": "."
                    },
                    {
                      "pattern": "^\\.\\."
                    },
                    {
                      "pattern": "[^-._a-zA-Z0-9]"
                    }
                  ]
                }
              }
            },
            "required": [
              "name",
              "key"
            ],
            "additionalProperties": false
          },
          "maxProperties": 128
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "allowedEnterpriseIds"
            ],
            "properties": {
              "allowedEnterpriseIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "env"
                  ],
                  "properties": {
                    "env": {
                      "minProperties": 1
                    }
                  }
                },
                {
                  "required": [
                    "secretEnv"
                  ],
                  "properties": {
                    "secretEnv": {
                      "minProperties": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true,
  "definitions": {
    "llmConnectionsV1_headers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
        "not": {
          "anyOf": [
            {
              "pattern": "^[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]$"
            },
            {
              "pattern": "^[pP][rR][oO][xX][yY]-[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]$"
            },
            {
              "pattern": "^[xX]-[aA][pP][iI]-[kK][eE][yY]$"
            },
            {
              "pattern": "^[aA][pP][iI]-[kK][eE][yY]$"
            },
            {
              "pattern": "^[xX]-[pP][oO][rR][tT][kK][eE][yY]-[aA][pP][iI]-[kK][eE][yY]$"
            },
            {
              "pattern": "^[hH][oO][sS][tT]$"
            },
            {
              "pattern": "^[cC][oO][oO][kK][iI][eE]$"
            },
            {
              "pattern": "^[aA][nN][tT][hH][rR][oO][pP][iI][cC]-[vV][eE][rR][sS][iI][oO][nN]$"
            },
            {
              "pattern": "^[aA][nN][tT][hH][rR][oO][pP][iI][cC]-[bB][eE][tT][aA]$"
            },
            {
              "pattern": "^[aA][pP][iI]-[vV][eE][rR][sS][iI][oO][nN]$"
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:\\$[A-Z][A-Z0-9_]*|[^$!\\x00-\\x1f\\x7f][^$\\x00-\\x1f\\x7f]*)$",
        "description": "Non-secret literal or whole-value $ENV_NAME reference; no commands or composite interpolation in this draft."
      }
    },
    "llmConnectionsV1_connection": {
      "type": "object",
      "properties": {
        "PLATFORM": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "PUBLISHER": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "NATIVE_PROVIDER": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "API": {
          "enum": [
            "anthropic-messages",
            "bedrock-converse-stream",
            "google-vertex",
            "google-generative-ai",
            "openai-responses",
            "openai-completions",
            "azure-openai-responses"
          ]
        },
        "BASE_URL": {
          "type": "string",
          "pattern": "^https://[^\\s/@?#]+(?:/[^\\s?#]*)?$"
        },
        "AUTH_MODE": {
          "enum": [
            "api-key",
            "aws-workload",
            "gcp-workload",
            "azure-workload"
          ]
        },
        "API_KEY_ENV": {
          "$ref": "#/definitions/llmConnectionsV1_secretDestination"
        },
        "NATIVE_ENV_REFS_JSON": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "not": {
              "anyOf": [
                {
                  "pattern": "^PHOENIX_LLM_"
                },
                {
                  "enum": [
                    "PHOENIX_AGENT_INPUTS_DIR",
                    "PHOENIX_AGENT_SECRET_NAMES_JSON"
                  ]
                }
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/llmConnectionsV1_plainDestination"
          }
        },
        "HEADERS_JSON": {
          "$ref": "#/definitions/llmConnectionsV1_headers"
        }
      },
      "required": [
        "PLATFORM",
        "PUBLISHER",
        "AUTH_MODE"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "AUTH_MODE": {
                "const": "api-key"
              }
            },
            "required": [
              "AUTH_MODE"
            ]
          },
          "then": {
            "required": [
              "API_KEY_ENV"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "AUTH_MODE": {
                "not": {
                  "const": "api-key"
                }
              }
            },
            "required": [
              "AUTH_MODE"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "API_KEY_ENV"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "llmConnectionsV1_bedrock-anthropic": {
      "title": "bedrock-anthropic",
      "description": "Named connection authoring; existing host profiles and modelIds supply the model target and trusted catalog association. Runtime capability is separately gated.",
      "allOf": [
        {
          "$ref": "#/definitions/llmConnectionsV1_connection"
        },
        {
          "properties": {
            "PLATFORM": {
              "const": "aws-bedrock"
            },
            "PUBLISHER": {
              "const": "anthropic"
            },
            "API": {
              "enum": [
                "bedrock-converse-stream"
              ]
            },
            "AUTH_MODE": {
              "enum": [
                "aws-workload",
                "api-key"
              ]
            },
            "NATIVE_PROVIDER": {
              "const": "amazon-bedrock"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "BASE_URL"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "NATIVE_ENV_REFS_JSON"
          ],
          "properties": {
            "NATIVE_ENV_REFS_JSON": {
              "type": "object",
              "properties": {
                "AWS_REGION": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                },
                "AWS_ROLE_ARN": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                },
                "AWS_WEB_IDENTITY_TOKEN_FILE": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                },
                "AWS_ROLE_SESSION_NAME": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                },
                "AWS_CONTAINER_CREDENTIALS_FULL_URI": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                },
                "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                },
                "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE": {
                  "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                }
              },
              "required": [
                "AWS_REGION"
              ],
              "additionalProperties": false,
              "dependencies": {
                "AWS_ROLE_ARN": [
                  "AWS_WEB_IDENTITY_TOKEN_FILE"
                ],
                "AWS_WEB_IDENTITY_TOKEN_FILE": [
                  "AWS_ROLE_ARN"
                ],
                "AWS_ROLE_SESSION_NAME": [
                  "AWS_ROLE_ARN"
                ]
              },
              "allOf": [
                {
                  "not": {
                    "required": [
                      "AWS_CONTAINER_CREDENTIALS_FULL_URI",
                      "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "AWS_ROLE_ARN"
                    ]
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "AWS_CONTAINER_CREDENTIALS_FULL_URI"
                          ]
                        },
                        {
                          "required": [
                            "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE"
                    ]
                  },
                  "then": {
                    "anyOf": [
                      {
                        "required": [
                          "AWS_CONTAINER_CREDENTIALS_FULL_URI"
                        ]
                      },
                      {
                        "required": [
                          "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "AUTH_MODE": {
                "const": "api-key"
              }
            },
            "required": [
              "AUTH_MODE"
            ]
          },
          "then": {
            "properties": {
              "NATIVE_ENV_REFS_JSON": {
                "type": "object",
                "properties": {
                  "AWS_REGION": {
                    "$ref": "#/definitions/llmConnectionsV1_plainDestination"
                  }
                },
                "required": [
                  "AWS_REGION"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
